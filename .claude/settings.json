{
  "permissions": {
    "allow": [
      "Bash(unity status:*)",
      "Bash(unity recompile:*)",
      "Bash(unity list:*)",
      "Bash(unity command console:*)",
      "Bash(unity command scene list_open:*)",
      "Bash(unity command scene get_hierarchy:*)",
      "Bash(unity command gameobject find:*)",
      "Bash(unity command package list:*)"
    ],
    "deny": [
      "Read(./Library/**)",
      "Read(./Temp/**)",
      "Read(./Logs/**)",
      "Read(./obj/**)",
      "Read(./UserSettings/**)",
      "Read(./WebGL Builds/**)"
    ]
  },
  "enabledPlugins": {
    "unity@unity-agent-plugin": true
  }
}
